# Firebase Web SDK (safe to expose to the browser; Security Rules remain authoritative)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Invisible reCAPTCHA Enterprise key registered with Firebase App Check
NEXT_PUBLIC_FIREBASE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Local Emulator Suite only
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=false
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG=false

# Custom API verification. Use the numeric Google Cloud project number.
FIREBASE_PROJECT_ID=
FIREBASE_PROJECT_NUMBER=
FIREBASE_WEB_APP_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_APP_CHECK_ENFORCED=false

# Firebase Admin. Prefer base64-encoded service-account JSON on non-Google hosts.
# Application Default Credentials can be used in Google-hosted environments.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional edge-runtime gateway. Set this to the deployed Firebase `api` function URL.
FIREBASE_FUNCTIONS_API_URL=

# API integrity and inbound webhook verification
API_IP_HASH_SALT=
MPESA_CALLBACK_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
CRM_WEBHOOK_SECRET=

# Existing operations allowlist retained as a server-side fallback.
MWENZA_ADMIN_EMAILS=

# Enable only on a host that strips and injects these identity headers itself.
TRUST_CHATGPT_AUTH_HEADERS=false
