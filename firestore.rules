rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function accountPath(uid) {
      return /databases/$(database)/documents/accounts/$(uid);
    }

    function account() {
      return get(accountPath(request.auth.uid)).data;
    }

    function hasRole(role) {
      return signedIn() && exists(accountPath(request.auth.uid)) && role in account().roles;
    }

    function isOperations() {
      return hasRole('operations');
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasValidAccountRoles(data) {
      return data.roles is list
        && data.roles.toSet().hasOnly(['customer', 'business', 'government', 'provider', 'operations'])
        && data.roles.toSet().hasAll(['customer'])
        && ((data.accountType == 'Home' && !('business' in data.roles) && !('government' in data.roles))
          || (data.accountType == 'Business' && ('business' in data.roles) && !('government' in data.roles))
          || (data.accountType == 'Government' && ('government' in data.roles) && !('business' in data.roles)));
    }

    function memberPath(orgId, uid) {
      return /databases/$(database)/documents/organizations/$(orgId)/members/$(uid);
    }

    function organizationPath(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId);
    }

    function isOrgMember(orgId) {
      return signedIn() && orgId != null && exists(memberPath(orgId, request.auth.uid));
    }

    function isOrgManager(orgId) {
      return isOrgMember(orgId) && get(memberPath(orgId, request.auth.uid)).data.role in ['owner', 'manager'];
    }

    function isOrgOwner(orgId) {
      return signedIn() && orgId != null && exists(organizationPath(orgId))
        && get(organizationPath(orgId)).data.ownerUid == request.auth.uid;
    }

    function isOrgBilling(orgId) {
      return isOrgMember(orgId)
        && get(memberPath(orgId, request.auth.uid)).data.role in ['owner', 'manager', 'billing'];
    }

    function isOwnerOrOrgMember(data) {
      return isOperations()
        || (signedIn() && data.ownerUid == request.auth.uid)
        || isOrgMember(data.organizationId);
    }

    function bookingPath(bookingId) {
      return /databases/$(database)/documents/bookings/$(bookingId);
    }

    function booking(bookingId) {
      return get(bookingPath(bookingId)).data;
    }

    function isBookingParticipant(bookingId) {
      return signedIn() && bookingId != null && exists(bookingPath(bookingId))
        && (booking(bookingId).ownerUid == request.auth.uid
          || booking(bookingId).assignedProviderUid == request.auth.uid
          || isOrgMember(booking(bookingId).organizationId));
    }

    function serviceRecordMatchesBooking() {
      let linkedBooking = getAfter(bookingPath(request.resource.data.bookingId)).data;
      return request.resource.data.ownerUid == linkedBooking.ownerUid
        && request.resource.data.organizationId == linkedBooking.organizationId
        && request.resource.data.providerUid == linkedBooking.assignedProviderUid
        && request.resource.data.status == linkedBooking.status;
    }

    match /accounts/{uid} {
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && hasValidAccountRoles(request.resource.data)
        && request.resource.data.roles.toSet().hasOnly(['customer', 'business', 'government'])
        && request.resource.data.organizationIds is list
        && request.resource.data.organizationIds.size() <= 25
        && request.resource.data.accountType in ['Home', 'Business', 'Government']
        && request.resource.data.status == 'Active';
      allow read: if isSelf(uid) || isOperations();
      allow update: if isOperations() || (isSelf(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.status == resource.data.status
        && hasValidAccountRoles(request.resource.data)
        && request.resource.data.organizationIds is list
        && request.resource.data.organizationIds.size() <= 25
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'phone', 'serviceArea', 'accountType', 'businessName', 'roles', 'organizationIds', 'updatedAt'])
        && request.resource.data.roles.toSet().difference(resource.data.roles.toSet()).hasOnly(['customer', 'business', 'government'])
        && resource.data.roles.toSet().difference(request.resource.data.roles.toSet()).hasOnly(['customer', 'business', 'government']));
      allow delete: if isOperations();
    }

    match /organizations/{orgId} {
      allow create: if hasRole('customer')
        && request.resource.data.id == orgId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.type in ['business', 'government']
        && request.resource.data.status == 'New lead';
      allow read: if isOperations() || isOrgMember(orgId);
      allow update: if isOperations() || (isOrgManager(orgId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.type == resource.data.type
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'services', 'frequency', 'locationCount', 'contact', 'updatedAt']));
      allow delete: if isOperations();

      match /members/{uid} {
        allow read: if isOperations() || isOrgMember(orgId);
        allow create: if isOperations()
          || (isSelf(uid)
            && getAfter(organizationPath(orgId)).data.ownerUid == uid
            && request.resource.data.uid == uid
            && request.resource.data.role == 'owner')
          || (isOrgOwner(orgId)
            && uid != request.auth.uid
            && request.resource.data.uid == uid
            && request.resource.data.role in ['manager', 'billing', 'viewer']);
        allow update: if isOperations() || (isOrgOwner(orgId)
          && uid != request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role in ['manager', 'billing', 'viewer']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt']));
        allow delete: if isOperations() || (isOrgOwner(orgId) && uid != request.auth.uid);
      }
    }

    match /bookings/{bookingId} {
      allow create: if hasRole('customer')
        && request.resource.data.id == bookingId
        && request.resource.data.ownerUid == request.auth.uid
        && (request.resource.data.organizationId == null || isOrgMember(request.resource.data.organizationId))
        && ((request.resource.data.customerType == 'Home' && request.resource.data.organizationId == null)
          || (request.resource.data.customerType in ['Business', 'Government & Institution'] && request.resource.data.organizationId != null))
        && request.resource.data.assignedProviderUid == null
        && (!('assignedProviderId' in request.resource.data) || request.resource.data.assignedProviderId == null)
        && (!('assignedProviderName' in request.resource.data) || request.resource.data.assignedProviderName == null)
        && request.resource.data.status == 'Confirmation pending';
      allow read: if isOperations()
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || (signedIn() && resource.data.assignedProviderUid == request.auth.uid && hasRole('provider'))
        || isOrgMember(resource.data.organizationId);
      allow update: if isOperations()
        || (signedIn() && resource.data.ownerUid == request.auth.uid
          && ((request.resource.data.status == 'Reschedule requested'
              && resource.data.status in ['Confirmation pending', 'Reschedule requested', 'Assigned', 'Provider assigned']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'scheduledDay', 'scheduledDate', 'scheduledTime', 'updatedAt']))
            || (request.resource.data.status == 'Cancelled'
              && resource.data.status in ['Confirmation pending', 'Reschedule requested', 'Assigned', 'Provider assigned']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'updatedAt']))))
        || (signedIn() && resource.data.assignedProviderUid == request.auth.uid && hasRole('provider')
          && ((resource.data.status in ['Assigned', 'Provider assigned']
              && request.resource.data.status == 'En route'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'enRouteAt', 'updatedAt']))
            || (resource.data.status == 'En route'
              && request.resource.data.status == 'Arrived'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'arrivedAt', 'updatedAt']))
            || (resource.data.status == 'Arrived'
              && request.resource.data.status == 'In progress'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'startedAt', 'updatedAt']))
            || (resource.data.status == 'In progress'
              && request.resource.data.status == 'Completed'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt', 'updatedAt']))));
      allow delete: if isOperations();
    }

    match /providerApplications/{applicationId} {
      allow create: if hasRole('customer')
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'Received';
      allow read: if isOperations() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update, delete: if isOperations();
    }

    match /providerProfiles/{uid} {
      allow read: if isOperations() || isSelf(uid);
      allow create, delete: if isOperations();
      allow update: if isOperations() || (isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acceptingWork', 'updatedAt']));
    }

    match /serviceRecords/{recordId} {
      allow create: if isOperations() || (signedIn() && serviceRecordMatchesBooking()
        && ((request.resource.data.ownerUid == request.auth.uid
          && ((request.resource.data.status == 'Confirmation pending' && request.resource.data.event == 'Booking requested')
            || (request.resource.data.status == 'Reschedule requested' && request.resource.data.event == 'Customer requested reschedule')
            || (request.resource.data.status == 'Cancelled' && request.resource.data.event == 'Customer cancelled booking')))
          || (request.resource.data.providerUid == request.auth.uid && hasRole('provider')
            && ((request.resource.data.status == 'En route' && request.resource.data.event == 'Provider marked En route')
              || (request.resource.data.status == 'Arrived' && request.resource.data.event == 'Provider marked Arrived')
              || (request.resource.data.status == 'In progress' && request.resource.data.event == 'Provider marked In progress')
              || (request.resource.data.status == 'Completed' && request.resource.data.event == 'Provider marked Completed')))));
      allow read: if isOperations()
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || (signedIn() && resource.data.providerUid == request.auth.uid && hasRole('provider'))
        || isOrgMember(resource.data.organizationId);
      allow update, delete: if isOperations();
    }

    match /applications/{applicationId} {
      allow create: if signedIn()
        && request.resource.data.id == applicationId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.applicationType in ['job', 'provider', 'franchise']
        && request.resource.data.status == 'Received';
      allow read: if isOperations() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update, delete: if isOperations();
    }

    match /businessRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.id == requestId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'New lead';
      allow read: if isOperations() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update, delete: if isOperations();
    }

    match /incidents/{incidentId} {
      allow read: if isOwnerOrOrgMember(resource.data);
      allow create: if signedIn()
        && request.resource.data.id == incidentId
        && request.resource.data.ownerUid == request.auth.uid
        && (request.resource.data.organizationId == null || isOrgMember(request.resource.data.organizationId))
        && (request.resource.data.bookingId == null || isBookingParticipant(request.resource.data.bookingId))
        && request.resource.data.status == 'Open';
      allow update, delete: if isOperations();
    }

    match /notifications/{notificationId} {
      allow read: if isOperations() || (signedIn()
        && (resource.data.recipientUid == request.auth.uid
          || resource.data.recipientEmail == request.auth.token.email));
      allow update: if signedIn()
        && (resource.data.recipientUid == request.auth.uid
          || resource.data.recipientEmail == request.auth.token.email)
        && request.resource.data.status == 'Read'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'readAt']);
      allow create, delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if isOwnerOrOrgMember(resource.data);
      allow write: if false;
    }

    match /invoices/{invoiceId} {
      allow read: if isOperations() || isOrgMember(resource.data.organizationId);
      allow write: if false;
    }

    match /procurementRecords/{recordId} {
      allow read: if isOperations() || isOrgMember(resource.data.organizationId);
      allow write: if false;
    }

    match /files/{fileId} {
      allow read: if isOperations()
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || isOrgMember(resource.data.organizationId)
        || isBookingParticipant(resource.data.bookingId);
      allow write: if false;
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'Published'
        || isOperations()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if false;
    }

    match /providerVerifications/{uid} {
      allow read: if isOperations() || isSelf(uid);
      allow write: if false;
    }

    match /availability/{uid} {
      allow read: if isOperations() || isSelf(uid);
      allow create: if isSelf(uid) && hasRole('provider') && request.resource.data.providerUid == uid;
      allow update: if isOperations() || (isSelf(uid) && hasRole('provider')
        && request.resource.data.providerUid == resource.data.providerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acceptingWork', 'days', 'windows', 'serviceAreas', 'unavailableUntil', 'updatedAt']));
      allow delete: if isOperations();
    }

    match /addresses/{addressId} {
      allow read: if isOwnerOrOrgMember(resource.data);
      allow create: if signedIn()
        && request.resource.data.id == addressId
        && request.resource.data.ownerUid == request.auth.uid
        && (request.resource.data.organizationId == null || isOrgManager(request.resource.data.organizationId));
      allow update: if isOperations()
        || ((signedIn() && resource.data.ownerUid == request.auth.uid) || isOrgManager(resource.data.organizationId))
          && request.resource.data.id == resource.data.id
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['label', 'address', 'latitude', 'longitude', 'instructions', 'isDefault', 'updatedAt']);
      allow delete: if isOperations()
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || isOrgManager(resource.data.organizationId);
    }

    match /servicePricing/{pricingId} {
      allow read: if resource.data.active == true || isOperations();
      allow write: if false;
    }

    match /outboundWebhooks/{webhookId} {
      allow read: if isOperations() || isOrgManager(resource.data.organizationId);
      allow write: if false;
    }

    match /webhookDeliveries/{deliveryId} {
      allow read: if isOperations() || isOrgMember(resource.data.organizationId);
      allow write: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isOperations();
      allow write: if false;
    }

    match /inboundWebhookEvents/{eventId} {
      allow read: if isOperations();
      allow write: if false;
    }

    match /webhookSecrets/{secretId} {
      allow read, write: if false;
    }

    match /idempotencyKeys/{keyId} {
      allow read, write: if false;
    }

    match /rateLimits/{bucketId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
